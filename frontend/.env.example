# TruthLens AI Frontend - Environment Configuration Template
# Copy this file to .env and fill in your values
# This file is safe to commit (no secrets)

# Backend API base URL
# Development: http://127.0.0.1:8000
# Production: https://your-api-domain.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Feature flags (controlled by backend availability)
VITE_ENABLE_OCR=false
VITE_ENABLE_TRANSLATION=false
VITE_ENABLE_MONITORING=false
VITE_ENABLE_SOCIAL_CONNECTORS=false