# TruthLens AI - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=development
DATABASE_URL=sqlite:///./truthlens.db
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# MODEL SETTINGS
# =============================================================================
MODEL_DIR=./models
TFIDF_MODEL_VERSION=1.0.0
CLASSIFIER_THRESHOLD=0.0

# =============================================================================
# EVIDENCE RETRIEVAL - GDELT (Public, no key required)
# =============================================================================
GDELT_ENABLED=true
GDELT_TIMEOUT_SECONDS=10
GDELT_MAX_RESULTS=10
GDELT_TIME_WINDOW_DAYS=7

# =============================================================================
# EVIDENCE RETRIEVAL - GOOGLE FACT CHECK TOOLS API (REQUIRED FOR PRODUCTION)
# =============================================================================
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable "Fact Check Tools API" in Google Cloud Console
GOOGLE_FACTCHECK_ENABLED=false
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here
GOOGLE_FACTCHECK_MAX_RESULTS=10
GOOGLE_FACTCHECK_LANGUAGE_CODES=en,hi,te,ta,kn,ml,mr,bn,gu,pa,or,ur

# =============================================================================
# SOCIAL PLATFORM CONNECTORS (Optional - require approved developer accounts)
# =============================================================================

# X (Twitter) API v2 - Academic/Enterprise access required for full archive
# Apply at: https://developer.twitter.com/en/portal/projects-and-apps
X_API_ENABLED=false
X_BEARER_TOKEN=your_x_bearer_token_here
X_API_MAX_RESULTS=10

# Meta/Facebook Graph API
# Create app at: https://developers.facebook.com/apps/
META_FACEBOOK_ENABLED=false
META_ACCESS_TOKEN=your_meta_access_token_here
META_APP_SECRET=your_meta_app_secret_here

# WhatsApp Cloud API
# Setup at: https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# =============================================================================
# OCR SETTINGS
# =============================================================================
# Install Tesseract from: https://github.com/UB-Mannheim/tesseract/wiki
# Download language data from: https://tesseract-ocr.github.io/tessdata/
TESSERACT_ENABLED=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGES=eng,hin,tel,tam,kan,mal,mar,ben,guj,pan,ori,urd
TESSERACT_DPI=300
TESSERACT_PREPROCESS=true

# Google Cloud Vision OCR (Optional cloud fallback)
# Enable Vision API at: https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_VISION_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# =============================================================================
# TRANSLATION - ARGOS TRANSLATE (Offline, open-source)
# =============================================================================
# Install: pip install argostranslate
# Download models: argospm install translate-<lang>_en
# List available: argospm search
ARGOS_ENABLED=true
ARGOS_PIVOT_LANGUAGE=en
ARGOS_AUTO_DOWNLOAD=false

# Optional: AI4Bharat IndicTrans2 (Better quality for Indian languages)
# Requires: transformers, torch, sentencepiece
INDIC_TRANS2_ENABLED=false
INDIC_TRANS2_MODEL_DIR=./models/indictrans2
INDIC_TRANS2_DEVICE=cpu

# =============================================================================
# NEWS API (Optional - Developer tier has 24hr delay, not for production)
# =============================================================================
# Get key at: https://newsapi.org/register
# WARNING: Free tier is for development/testing only, 24-hour delay
# Production requires paid plan: https://newsapi.org/pricing
NEWSAPI_ENABLED=false
NEWSAPI_KEY=your_newsapi_key_here

# =============================================================================
# INPUT PROCESSING LIMITS
# =============================================================================
INPUT_TIMEOUT_SECONDS=15
INPUT_MAX_LENGTH=100000
INPUT_MAX_RESPONSE_BYTES=5000000
INPUT_MAX_UPLOAD_BYTES=10000000
INPUT_MAX_IMAGE_PIXELS=25000000
INPUT_MAX_REDIRECTS=5
INPUT_USER_AGENT=TruthLensAI/1.0 (news analysis; +https://github.com/truthlens)

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Comma-separated origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:3000

# =============================================================================
# MONITORING & SCHEDULER
# =============================================================================
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_INSTANCES=3

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10